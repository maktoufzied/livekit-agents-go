# Copy to .env and fill in. Never commit .env.
#
#   set -a; source .env; set +a; go run ./examples/voice-assistant
#   docker run --rm --env-file .env livekit-agents-go-example

# --- LiveKit (required) -----------------------------------------------------
# Local dev server (`livekit-server --dev`): ws://localhost:7880, devkey, secret
# LiveKit Cloud: wss://<project>.livekit.cloud and a project API key pair
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Speech: Deepgram (STT and TTS) ------------------------------------------
DEEPGRAM_API_KEY=

# --- LLM: set one. Anthropic is used when both are set. ----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-haiku-5-5 for the lowest latency.
LLM_MODEL=

# --- Optional worker settings -----------------------------------------------
# Default agent name when the code sets none (explicit dispatch).
# LIVEKIT_AGENT_NAME=
# Set by LiveKit Cloud for hosted agents; do not set them yourself:
# LIVEKIT_WORKER_TOKEN, LIVEKIT_AGENT_DEPLOYMENT, LIVEKIT_AGENT_NAME_OVERRIDE

# --- Examples ------------------------------------------------------------------
# 1 = run the examples without any provider key (scripted replies, tone audio).
AGENT_FAKE_PROVIDERS=
# debug = verbose logs
LOG_LEVEL=
